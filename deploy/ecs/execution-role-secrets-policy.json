{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAtriumSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:<RDS_SECRET_NAME>*",
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:atrium/setup-token*"
      ]
    }
  ]
}
