{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AtriumUploadsObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::<ATRIUM_UPLOADS_BUCKET>/uploads/*"
    },
    {
      "Sid": "AtriumUploadsReadinessHead",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<ATRIUM_UPLOADS_BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": ["uploads/*"] } }
    }
  ]
}
